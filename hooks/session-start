#!/usr/bin/env bash
# SessionStart hook for SpecFlow

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

concepts_content=$(cat "${REPO_ROOT}/framework/concepts.md" 2>&1 || echo "Error reading framework/concepts.md")

escape_for_json() {
    # Real tab/CR characters (bash $'...' quoting) are embedded into the sed
    # script so the match relies only on literal character matching, which
    # every POSIX sed supports — the \t / \r escape forms are a GNU/BSD
    # extension and must not be relied on.
    local tab=$'\t' cr=$'\r'
    printf '%s\n' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/${tab}/\\\\t/g" -e "s/${cr}/\\\\r/g" -e 's/$/\\n/' | tr -d '\n' | sed 's/\\n$//'
}

concepts_escaped=$(escape_for_json "$concepts_content")
session_context="<SPECFLOW_CONCEPTS>\nThis project uses SpecFlow to manage design documents.\n\n**Below is the full SpecFlow framework guide — read it carefully before starting work:**\n\n${concepts_escaped}\n</SPECFLOW_CONCEPTS>"

target_platform="${1:-}"

if [ "$target_platform" = "antigravity" ] || [ -n "${ANTIGRAVITY:-}" ]; then
  printf '{\n  "injectSteps": [\n    {\n      "ephemeralMessage": "%s"\n    }\n  ]\n}\n' "$session_context"
  exit 0
fi

if [ "$target_platform" = "claude" ] || ([ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]); then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
  exit 0
fi

exit 0
